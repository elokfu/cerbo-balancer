  {
    "id": "bal-maint-format",
    "type": "function",
    "z": "bal-tab",
    "name": "Format maintenance telemetry",
    "func": "const snapshot = flow.get('balancerRs485Snapshot') || {}\nconst number = (value, digits = 3) => typeof value === 'number' && Number.isFinite(value) ? value.toFixed(digits) : '—'\nconst aggregate = snapshot.aggregate || {}\nconst system = snapshot.system || {}\nconst limits = snapshot.limits || {}\nconst discovery = snapshot.discovery || {}\nconst inventory = snapshot.inventory || {}\n\nconst batteries = (snapshot.batteries || []).map((battery) => {\n    const cells = battery.effectiveCells || battery.effective_cells || []\n    const cellValues = cells.map((cell) => cell.voltage).filter((value) => typeof value === 'number' && Number.isFinite(value))\n    return {\n        address: battery.address,\n        valid: battery.valid === true,\n        voltage: number(battery.voltage),\n        current: number(battery.current, 1),\n        delta: number(battery.systemVoltageDeltaMv ?? battery.system_voltage_delta_mv, 1),\n        cellSpread: cellValues.length ? number(Math.max(...cellValues) - Math.min(...cellValues)) : '—',\n        cells: cells.map((cell) => ({ index: cell.index, voltage: number(cell.voltage) })),\n        temperatures: (battery.temperatures || []).map((value, index) => ({ index: index + 1, value: number(value, 1) })),\n        minimumTemperature: number(battery.minimumTemperature ?? battery.minimum_temperature, 1),\n        maximumTemperature: number(battery.maximumTemperature ?? battery.maximum_temperature, 1),\n        averageTemperature: number(battery.averageTemperature ?? battery.average_temperature, 1),\n        reportedSum: number(battery.directlyReportedCellSum ?? battery.directly_reported_cell_sum),\n        reconstructedSum: number(battery.reconstructedCellSum ?? battery.reconstructed_cell_sum),\n        voltageDelta: number(battery.reconstructedVoltageDeltaMv ?? battery.reconstructed_voltage_delta_mv, 1),\n        errors: battery.validationErrors || battery.validation_errors || []\n    }\n})\n\nmsg.payload = {\n    decoder: snapshot.decoderHealth || 'unknown',\n    valid: snapshot.valid === true,\n    port: snapshot.serialPort || '—',\n    baud: snapshot.baud || '—',\n    age: snapshot.telemetryAge == null ? '—' : `${snapshot.telemetryAge} ms`,\n    system: { voltage: number(system.voltage61), soc: number(system.soc61, 1) },\n    limits: {\n        chargeVoltage: number(limits.chargeVoltage),\n        dischargeVoltage: number(limits.dischargeVoltage),\n        ccl: number(limits.chargeCurrent, 1),\n        dcl: number(limits.dischargeCurrentSigned, 1),\n        status: limits.statusRaw == null ? '—' : `0x${Number(limits.statusRaw).toString(16).toUpperCase()}`\n    },\n    discovery: {\n        count: discovery.respondingCount || 0,\n        addresses: (discovery.respondingAddresses || []).join(', ') || '—'\n    },\n    aggregate: {\n        vmin: number(aggregate.vmin),\n        vmax: number(aggregate.vmax),\n        spread: number((aggregate.spread || 0) * 1000, 1),\n        min: `${aggregate.minCellAddress ?? '—'} / cell ${aggregate.minCellIndex ?? '—'}`,\n        max: `${aggregate.maxCellAddress ?? '—'} / cell ${aggregate.maxCellIndex ?? '—'}`,\n        current: number(aggregate.summedBatteryCurrent, 1),\n        temperature: `${number(aggregate.minimumTemperature, 1)}–${number(aggregate.maximumTemperature, 1)} °C`\n    },\n    inventory: {\n        activeAddresses: inventory.activeAddresses || discovery.activeAddresses || [],\n        pendingRemoval: (inventory.pendingRemoval || discovery.pendingRemoval || []).map((item) => ({\n            address: item.address,\n            missedScans: item.missedScans,\n            maxAttempts: item.maxAttempts || 10,\n            lastSeenAt: item.lastSeenAt\n        })),\n        mode: inventory.discoveryMode || 'normal',\n        scanIntervalSeconds: inventory.scanIntervalSeconds || 60,\n        nextDiscoveryInSeconds: inventory.nextDiscoveryInSeconds\n    },\n    batteries\n}\nreturn msg\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 700,
    "wires": [
      [
        "bal-maintenance"
      ]
    ]
  },
  {
    "id": "bal-maintenance",
    "type": "ui-template",
    "z": "bal-tab",
    "group": "bal-maint-group",
    "name": "RS485 maintenance telemetry",
    "order": 1,
    "width": 12,
    "height": 15,
    "format": "<template>\n  <div class=\"maintenance\" v-if=\"msg?.payload\">\n    <div class=\"title-row\"><div><h2>Dyness RS485 telemetry</h2><span class=\"subtle\">Updated {{ msg.payload.age }} ago · {{ msg.payload.port }} · {{ msg.payload.baud }} baud</span></div><span class=\"badge\" :class=\"msg.payload.valid ? 'good' : 'bad'\">{{ msg.payload.valid ? 'VALID' : 'INVALID' }}</span></div>\n    <div class=\"inventory\" :class=\"msg.payload.inventory.pendingRemoval.length ? 'recovery' : 'normal'\"><strong>Inventory</strong><span>Active: {{ msg.payload.inventory.activeAddresses.join(', ') || 'none' }}</span><span>Discovery: {{ msg.payload.inventory.mode }} every {{ msg.payload.inventory.scanIntervalSeconds }} s</span><span v-if=\"msg.payload.inventory.nextDiscoveryInSeconds != null\">Next scan: {{ msg.payload.inventory.nextDiscoveryInSeconds }} s</span><span v-for=\"item in msg.payload.inventory.pendingRemoval\" :key=\"item.address\" class=\"pending\">Battery {{ item.address }} missing — retry {{ item.missedScans }}/{{ item.maxAttempts }}</span></div>\n    <div class=\"cards\"><div class=\"card\"><span>System voltage</span><strong>{{ msg.payload.system.voltage }} V</strong><small>CID2 61</small></div><div class=\"card\"><span>State of charge</span><strong>{{ msg.payload.system.soc }} %</strong><small>CID2 61</small></div><div class=\"card\"><span>Vmin / Vmax</span><strong>{{ msg.payload.aggregate.vmin }} / {{ msg.payload.aggregate.vmax }} V</strong><small>All packs spread {{ msg.payload.aggregate.spread }} mV</small></div><div class=\"card\"><span>Battery current</span><strong>{{ msg.payload.aggregate.current }} A</strong><small>{{ msg.payload.aggregate.temperature }}</small></div></div>\n    <section><h3>Limits and discovery</h3><table><tbody><tr><th>Charge voltage</th><td>{{ msg.payload.limits.chargeVoltage }} V</td><th>Discharge voltage</th><td>{{ msg.payload.limits.dischargeVoltage }} V</td></tr><tr><th>CCL</th><td>{{ msg.payload.limits.ccl }} A</td><th>DCL</th><td>{{ msg.payload.limits.dcl }} A</td></tr><tr><th>Status</th><td>{{ msg.payload.limits.status }}</td><th>Responding</th><td>{{ msg.payload.discovery.count }} ({{ msg.payload.discovery.addresses }})</td></tr><tr><th>Vmin location</th><td>{{ msg.payload.aggregate.min }}</td><th>Vmax location</th><td>{{ msg.payload.aggregate.max }}</td></tr></tbody></table></section>\n    <section v-for=\"b in msg.payload.batteries\" :key=\"b.address\" class=\"battery\"><div class=\"battery-head\"><h3>Battery {{ b.address }}</h3><span class=\"badge\" :class=\"b.valid ? 'good' : 'bad'\">{{ b.valid ? 'VALID' : 'INVALID' }}</span></div><div class=\"battery-meta\"><span><b>{{ b.voltage }} V</b> voltage</span><span><b>{{ b.current }} A</b> current</span><span><b>{{ b.cellSpread }} V</b> cell spread</span><span><b>{{ b.delta }} mV</b> vs system</span><span><b>{{ b.minimumTemperature }}–{{ b.maximumTemperature }} °C</b> temperature</span></div><h4>Cell voltages</h4><div class=\"cells\"><div v-for=\"c in b.cells\" :key=\"c.index\" class=\"cell\"><span>Cell {{ String(c.index).padStart(2, '0') }}</span><b>{{ c.voltage }} V</b></div></div><h4>Temperatures</h4><div class=\"temps\"><span v-for=\"t in b.temperatures\" :key=\"t.index\">T{{ t.index }}: <b>{{ t.value }} °C</b></span></div><div class=\"subtle\">Reported sum {{ b.reportedSum }} V · reconstructed {{ b.reconstructedSum }} V · difference {{ b.voltageDelta }} mV · {{ b.errors.length ? b.errors.join('; ') : 'no validation errors' }}</div></section>\n    <div v-if=\"!msg.payload.batteries.length\" class=\"waiting\">No active battery telemetry. Discovery is continuing according to the inventory state above.</div>\n  </div><div v-else class=\"waiting\">Waiting for RS485 telemetry…</div>\n</template>\n<style>\n.maintenance { color: var(--v-theme-on-surface); font-size: 14px; } .title-row,.battery-head { display:flex; justify-content:space-between; align-items:center; gap:12px; } h2,h3,h4 { margin: 0 0 8px; } h3 { margin-top: 4px; } h4 { margin-top: 14px; font-size: 13px; } .subtle,small { color: rgba(0,0,0,.62); font-size: 12px; } .inventory { display:flex; flex-wrap:wrap; gap:12px; align-items:center; padding:9px 12px; margin:12px 0; border-radius:8px; background:#eef4f8; } .inventory.recovery { background:#fff1d6; } .inventory .pending { color:#9a5c00; font-weight:600; } .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin:14px 0; } .card,section { border:1px solid rgba(0,0,0,.12); border-radius:8px; padding:12px; background:rgba(255,255,255,.55); } .card { display:flex; flex-direction:column; gap:4px; } .card strong { font-size:20px; } table { width:100%; border-collapse:collapse; } th,td { text-align:left; padding:7px 8px; border-bottom:1px solid rgba(0,0,0,.1); } th { font-weight:600; width:18%; } .battery { margin-top:12px; } .battery-meta,.temps { display:flex; flex-wrap:wrap; gap:14px; margin:8px 0; } .cells { display:grid; grid-template-columns:repeat(auto-fit,minmax(90px,1fr)); gap:6px; } .cell { display:flex; flex-direction:column; gap:2px; padding:7px; border-radius:6px; background:rgba(0,0,0,.04); } .cell b { font-size:16px; } .badge { border-radius:999px; padding:4px 9px; font-size:11px; font-weight:700; background:#ddd; } .badge.good { color:#176b35; background:#d9f4df; } .badge.bad { color:#9d2727; background:#f9dddd; } .waiting { padding:16px; }\n</style>\n",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 730,
    "y": 700,
    "wires": []
