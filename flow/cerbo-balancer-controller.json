  {
    "id": "bal-controller",
    "type": "function",
    "z": "bal-tab",
    "name": "Dyness shadow controller",
    "func": "const source = Buffer.from(\"\", 'base64').toString('utf8'); let controller = context.get('controller'); if (!controller) { const module = { exports: {} }; eval(source); controller = module.exports.createBalancerController(); context.set('controller', controller); controller.handle({ type: 'load', timestamp: Date.now() }); } const snapshot = msg.topic === 'rs485' ? msg.payload : flow.get('balancerRs485Snapshot'); let actions; if (msg.topic === 'controller_tick') actions = controller.handle({ type: 'tick', timestamp: Date.now() }); else if (snapshot) { const system = snapshot.system || {}; const limits = snapshot.limits || {}; const aggregate = snapshot.aggregate || {}; actions = controller.handle({ type: 'telemetry', timestamp: Date.now(), telemetry: { ...snapshot, timestamp: snapshot.timestamp, valid: snapshot.valid, cellTelemetryValid: snapshot.cellTelemetryValid, packVoltage: system.voltage61, packCurrent: aggregate.summedBatteryCurrent, soc: system.soc61, vmax: aggregate.vmax, vmin: aggregate.vmin, maxCellIndex: aggregate.maxCellIndex, minCellIndex: aggregate.minCellIndex, ccl: limits.chargeCurrent, dcl: limits.dischargeCurrentSigned, cvl: limits.chargeVoltage, batteries: snapshot.batteries || [] } }); } else return null; const status = actions.find(action => action.type === 'status'); const intent = actions.find(action => action.type === 'voltage_intent'); const persist = actions.find(action => action.type === 'persist'); return [status ? { topic: 'controller_status', payload: status.status } : null, intent ? { topic: 'controller_command', payload: JSON.stringify({ version: Date.now(), timestamp: Date.now(), mode: controller.getState().mode, requestedVoltage: intent.value, requestedCurrent: intent.command && intent.command.chargeCurrentCommand }) } : null, persist ? { topic: 'controller_state', payload: JSON.stringify(persist) } : null];",
    "outputs": 3,
