  {
    "id": "bal-rs485-line",
    "type": "function",
    "z": "bal-tab",
    "name": "Validate RS485 snapshot",
    "func": "const line = String(msg.payload || '').trim();\nif (!line.startsWith('{')) return null;\ntry {\n  const snapshot = JSON.parse(line);\n  if (!snapshot || snapshot.source !== 'rs485-dyness') return null;\n  flow.set('balancerRs485Snapshot', snapshot);\n  if (snapshot.valid === true) flow.set('balancerRs485LastValidSnapshot', snapshot);\n  msg.topic = 'rs485';\n  msg.payload = snapshot;\n  return msg;\n} catch (error) { node.warn(`invalid RS485 JSON: ${error.message}`); return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 520,
    "wires": [["bal-maint-store", "bal-controller"]]
  },
  {
    "id": "bal-maint-store",
    "type": "function",
    "z": "bal-tab",
    "name": "Store latest RS485 snapshot",
    "func": "flow.set('balancerRs485Snapshot', msg.payload); return null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
