  {
    "id": "bal-maint-format",
    "type": "function",
    "z": "bal-tab",
    "name": "Format maintenance telemetry",
    "func": "const s = flow.get('balancerRs485Snapshot') || {}; const n = (v, d = 3) => typeof v === 'number' && Number.isFinite(v) ? v.toFixed(d) : '—'; const a = s.aggregate || {}; const sys = s.system || {}; const lim = s.limits || {}; const disc = s.discovery || {}; const batteries = (s.batteries || []).map(b => { const rawCells = b.effectiveCells || b.effective_cells || []; const cellValues = rawCells.map(c => c.voltage).filter(v => typeof v === 'number' && Number.isFinite(v)); const cellSpread = cellValues.length ? n(Math.max(...cellValues) - Math.min(...cellValues), 3) : '—'; return { address: b.address, valid: b.valid === true, voltage: n(b.voltage), current: n(b.current, 1), delta: n(b.systemVoltageDeltaMv ?? b.system_voltage_delta_mv, 1), cellSpread, cells: rawCells.map(c => ({ index: c.index, voltage: n(c.voltage), source: c.source })), temperatures: (b.temperatures || []).map((t, i) => ({ index: i + 1, value: n(t, 1) })), minimumTemperature: n(b.minimumTemperature ?? b.minimum_temperature, 1), maximumTemperature: n(b.maximumTemperature ?? b.maximum_temperature, 1), averageTemperature: n(b.averageTemperature ?? b.average_temperature, 1), reportedSum: n(b.directlyReportedCellSum ?? b.directly_reported_cell_sum), reconstructedSum: n(b.reconstructedCellSum ?? b.reconstructed_cell_sum), voltageDelta: n(b.reconstructedVoltageDeltaMv ?? b.reconstructed_voltage_delta_mv, 1), errors: b.validationErrors || b.validation_errors || [] }; }); msg.payload = { decoder: s.decoderHealth || 'unknown', valid: s.valid === true, port: s.serialPort || '—', baud: s.baud || '—', age: s.telemetryAge == null ? '—' : `${s.telemetryAge} ms`, system: { voltage: n(sys.voltage61), soc: n(sys.soc61, 1) }, limits: { chargeVoltage: n(lim.chargeVoltage), dischargeVoltage: n(lim.dischargeVoltage), ccl: n(lim.chargeCurrent, 1), dcl: n(lim.dischargeCurrentSigned, 1), status: lim.statusRaw == null ? '—' : `0x${Number(lim.statusRaw).toString(16).toUpperCase()}` }, discovery: { count: disc.respondingCount || 0, addresses: (disc.respondingAddresses || []).join(', ') || '—' }, aggregate: { vmin: n(a.vmin), vmax: n(a.vmax), spread: n((a.spread || 0) * 1000, 1), min: `${a.minCellAddress ?? '—'} / cell ${a.minCellIndex ?? '—'}`, max: `${a.maxCellAddress ?? '—'} / cell ${a.maxCellIndex ?? '—'}`, current: n(a.summedBatteryCurrent, 1), temperature: `${n(a.minimumTemperature, 1)}–${n(a.maximumTemperature, 1)} °C` }, batteries }; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 700,
    "wires": [["bal-maintenance"]]
  },
  {
    "id": "bal-maintenance",
    "type": "ui-template",
    "z": "bal-tab",
    "group": "bal-maint-group",
    "name": "RS485 maintenance telemetry",
    "order": 1,
    "width": 12,
    "height": 15,
    "format": "<template>\n  <div class=\"maintenance\" v-if=\"msg?.payload\">\n    <div class=\"title-row\"><div><h2>Dyness RS485 telemetry</h2><span class=\"subtle\">Updated {{ msg.payload.age }} ago · {{ msg.payload.port }} · {{ msg.payload.baud }} baud</span></div><span class=\"badge\" :class=\"msg.payload.valid ? 'good' : 'bad'\">{{ msg.payload.valid ? 'VALID' : 'INVALID' }}</span></div>\n    <div class=\"cards\"><div class=\"card\"><span>System voltage</span><strong>{{ msg.payload.system.voltage }} V</strong><small>CID2 61</small></div><div class=\"card\"><span>State of charge</span><strong>{{ msg.payload.system.soc }} %</strong><small>CID2 61</small></div><div class=\"card\"><span>Vmin / Vmax</span><strong>{{ msg.payload.aggregate.vmin }} / {{ msg.payload.aggregate.vmax }} V</strong><small>All packs spread {{ msg.payload.aggregate.spread }} mV</small></div><div class=\"card\"><span>Battery current</span><strong>{{ msg.payload.aggregate.current }} A</strong><small>{{ msg.payload.aggregate.temperature }}</small></div></div>\n    <section><h3>Limits and discovery</h3><table><tbody><tr><th>Charge voltage</th><td>{{ msg.payload.limits.chargeVoltage }} V</td><th>Discharge voltage</th><td>{{ msg.payload.limits.dischargeVoltage }} V</td></tr><tr><th>CCL</th><td>{{ msg.payload.limits.ccl }} A</td><th>DCL</th><td>{{ msg.payload.limits.dcl }} A</td></tr><tr><th>Status</th><td>{{ msg.payload.limits.status }}</td><th>Batteries</th><td>{{ msg.payload.discovery.count }} ({{ msg.payload.discovery.addresses }})</td></tr><tr><th>Vmin location</th><td>{{ msg.payload.aggregate.min }}</td><th>Vmax location</th><td>{{ msg.payload.aggregate.max }}</td></tr></tbody></table></section>\n    <section v-for=\"b in msg.payload.batteries\" :key=\"b.address\" class=\"battery\"><div class=\"battery-head\"><h3>Battery {{ b.address }}</h3><span class=\"badge\" :class=\"b.valid ? 'good' : 'bad'\">{{ b.valid ? 'VALID' : 'INVALID' }}</span></div><div class=\"battery-meta\"><span><b>{{ b.voltage }} V</b> voltage</span><span><b>{{ b.current }} A</b> current</span><span><b>{{ b.cellSpread }} V</b> cell spread</span><span><b>{{ b.delta }} mV</b> vs system</span><span><b>{{ b.minimumTemperature }}–{{ b.maximumTemperature }} °C</b> temperature</span></div><h4>Cell voltages</h4><div class=\"cells\"><div v-for=\"c in b.cells\" :key=\"c.index\" class=\"cell\"><span>Cell {{ String(c.index).padStart(2, '0') }}</span><b>{{ c.voltage }} V</b></div></div><h4>Temperatures</h4><div class=\"temps\"><span v-for=\"t in b.temperatures\" :key=\"t.index\">T{{ t.index }}: <b>{{ t.value }} °C</b></span></div><div class=\"subtle\">Reported sum {{ b.reportedSum }} V · reconstructed {{ b.reconstructedSum }} V · difference {{ b.voltageDelta }} mV · {{ b.errors.length ? b.errors.join('; ') : 'no validation errors' }}</div></section>\n  </div><div v-else class=\"waiting\">Waiting for RS485 telemetry…</div>\n</template>\n<style>\n.maintenance { color: var(--v-theme-on-surface); font-size: 14px; } .title-row,.battery-head { display:flex; justify-content:space-between; align-items:center; gap:12px; } h2,h3,h4 { margin: 0 0 8px; } h3 { margin-top: 4px; } h4 { margin-top: 14px; font-size: 13px; } .subtle,small { color: rgba(0,0,0,.62); font-size: 12px; } .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin:14px 0; } .card,section { border:1px solid rgba(0,0,0,.12); border-radius:8px; padding:12px; background:rgba(255,255,255,.55); } .card { display:flex; flex-direction:column; gap:4px; } .card strong { font-size:20px; } table { width:100%; border-collapse:collapse; } th,td { text-align:left; padding:7px 8px; border-bottom:1px solid rgba(0,0,0,.1); } th { font-weight:600; width:18%; } .battery { margin-top:12px; } .battery-meta,.temps { display:flex; flex-wrap:wrap; gap:14px; margin:8px 0; } .cells { display:grid; grid-template-columns:repeat(auto-fit,minmax(90px,1fr)); gap:6px; } .cell { display:flex; flex-direction:column; gap:2px; padding:7px; border-radius:6px; background:rgba(0,0,0,.04); } .cell b { font-size:16px; } .badge { border-radius:999px; padding:4px 9px; font-size:11px; font-weight:700; background:#ddd; } .badge.good { color:#176b35; background:#d9f4df; } .badge.bad { color:#9d2727; background:#f9dddd; } .waiting { padding:16px; }\n</style>",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 730,
    "y": 700,
    "wires": []
