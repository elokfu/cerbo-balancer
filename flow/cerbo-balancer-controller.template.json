  {
    "id": "bal-controller",
    "type": "function",
    "z": "bal-tab",
    "name": "Dyness shadow controller",
    "func": "const source = \"__CONTROLLER_SOURCE__\"; let controller = context.get('controller'); if (!controller) { const module = { exports: {} }; eval(source); controller = module.exports.createBalancerController(); context.set('controller', controller); controller.handle({ type: 'load', timestamp: Date.now() }); } const snapshot = msg.topic === 'rs485' ? msg.payload : flow.get('balancerRs485Snapshot'); let actions; if (msg.topic === 'controller_control' && msg.payload && msg.payload.type) actions = controller.handle({ ...msg.payload, timestamp: Date.now() }); else if (msg.topic === 'controller_tick') actions = controller.handle({ type: 'tick', timestamp: Date.now() }); else if (snapshot) { const system = snapshot.system || {}; const limits = snapshot.limits || {}; const aggregate = snapshot.aggregate || {}; const inventory = snapshot.inventory || {}; actions = controller.handle({ type: 'telemetry', timestamp: Date.now(), telemetry: { ...snapshot, timestamp: snapshot.timestamp, valid: snapshot.valid, cellTelemetryValid: snapshot.cellTelemetryValid, packVoltage: system.voltage61, packCurrent: aggregate.summedBatteryCurrent, soc: system.soc61, vmax: aggregate.vmax, vmin: aggregate.vmin, maxCellIndex: aggregate.maxCellIndex, minCellIndex: aggregate.minCellIndex, ccl: limits.chargeCurrent, dcl: limits.dischargeCurrentSigned, cvl: limits.chargeVoltage, limits, expectedBatteries: inventory.activeAddresses || snapshot.expectedAddresses || [], batteries: snapshot.batteries || [] } }); } else return null; const status = actions.find(action => action.type === 'status'); const command = actions.find(action => action.type === 'controller_command'); const persist = actions.find(action => action.type === 'persist'); return [status ? { topic: 'controller_status', payload: status.status } : null, command ? { topic: 'controller_command', payload: JSON.stringify(command.value) } : null, persist ? { topic: 'controller_state', payload: JSON.stringify(persist) } : null];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 820,
    "wires": [["bal-controller-format", "bal-controls"], ["bal-command-log", "bal-events-log"], ["bal-config-snapshot"]]
  },
  {
    "id": "bal-controller-format",
    "type": "function",
    "z": "bal-tab",
    "name": "Format controller status",
    "func": "const s = msg.payload || {}; const c = s.lastCommand || {}; msg.payload = `${s.mode} | ${s.state} | enabled=${s.enabled} | selected=${s.selectedAddress ?? '—'} | SOC entry/continue=${s.socEntryEligible ? 'YES' : 'no'}/${s.socContinuationEligible ? 'YES' : 'no'} | Icmd=${c.requestedCurrent == null ? '—' : Number(c.requestedCurrent).toFixed(1)} A | charge=${c.chargeEnabled ? 'ON' : 'OFF'} | ${s.lastStopReason || s.lockout || s.fault || 'normal policy'}`; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
