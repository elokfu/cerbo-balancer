[
  {
    "id": "bal-tab",
    "type": "tab",
    "label": "Cerbo Dyness Balancer",
    "disabled": false,
    "info": "TEST_MODE=true. Direct-CAN-first passive telemetry and shadow controller. RS485 is unavailable until its protocol is validated. State file: /data/home/nodered/cerbo-balancer-state.json.",
    "env": []
  },
  {
    "id": "victron-client-id",
    "type": "victron-client",
    "showValues": true,
    "contextStore": true,
    "enablePolling": false
  },
  {
    "id": "bal-page",
    "type": "ui-page",
    "name": "Dyness Balancer",
    "ui": "93f5777d13b8710a",
    "path": "/balancer",
    "icon": "dashboard",
    "layout": "grid",
    "theme": "2f1c77dc3fd27bf0",
    "breakpoints": [
      { "name": "Default", "px": 0, "cols": 3 },
      { "name": "Tablet", "px": 576, "cols": 6 },
      { "name": "Small Desktop", "px": 768, "cols": 9 },
      { "name": "Desktop", "px": 1024, "cols": 12 }
    ],
    "order": 3,
    "className": "",
    "visible": "true",
    "disabled": "false"
  },
  {
    "id": "bal-group",
    "type": "ui-group",
    "name": "Balancer status",
    "page": "bal-page",
    "width": 12,
    "height": 8,
    "order": 1,
    "showTitle": true,
    "className": "",
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "bal-can-reader",
    "type": "exec",
    "z": "bal-tab",
    "command": "python3 /data/home/nodered/cerbo-balancer/can_reader.py --interface can1",
    "addpay": false,
    "append": "",
    "useSpawn": "true",
    "timer": "",
    "winHide": false,
    "name": "Receive-only CAN reader",
    "x": 190,
    "y": 120,
    "wires": [["bal-can-line"], [], ["bal-reader-error"]]
  },
  {
    "id": "bal-battery-input",
    "type": "victron-input-battery",
    "z": "bal-tab",
    "service": "com.victronenergy.battery/512",
    "path": "/Dc/0/Voltage",
    "serviceObj": { "service": "com.victronenergy.battery/512", "name": "Dyness B3" },
    "pathObj": { "path": "/Dc/0/Voltage", "type": "float", "name": "Pack voltage" },
    "name": "Pack voltage (read-only)",
    "onlyChanges": false,
    "roundValues": "3",
    "x": 180,
    "y": 340,
    "wires": []
  },
  {
    "id": "bal-vebus-input",
    "type": "victron-input-vebus",
    "z": "bal-tab",
    "service": "com.victronenergy.vebus/276",
    "path": "/BatteryOperationalLimits/MaxChargeVoltage",
    "serviceObj": { "service": "com.victronenergy.vebus/276", "name": "VE.Bus" },
    "pathObj": { "path": "/BatteryOperationalLimits/MaxChargeVoltage", "type": "float", "name": "BMS CVL" },
    "name": "BMS CVL (read-only)",
    "onlyChanges": false,
    "roundValues": "3",
    "x": 180,
    "y": 380,
    "wires": []
  },
  {
    "id": "bal-can-line",
    "type": "function",
    "z": "bal-tab",
    "name": "Retain raw CAN frames",
    "func": "let frame;\ntry { frame = JSON.parse(String(msg.payload)); } catch (error) { return null; }\nif (!frame || frame.interface !== 'can1') return null;\nmsg.payload = JSON.stringify(frame);\nmsg.topic = 'can_frame';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 120,
    "wires": [["bal-can-log", "bal-raw-status"]]
  },
  {
    "id": "bal-can-log",
    "type": "file",
    "z": "bal-tab",
    "name": "Raw CAN telemetry log",
    "filename": "/data/home/nodered/cerbo-balancer/cerbo-balancer-telemetry.jsonl",
    "filenameType": "str",
    "appendNewline": true,
    "createDir": true,
    "overwriteFile": "false",
    "encoding": "none",
    "x": 740,
    "y": 100,
    "wires": [[]]
  },
  {
    "id": "bal-reader-error",
    "type": "debug",
    "z": "bal-tab",
    "name": "CAN reader errors",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "true",
    "targetType": "full",
    "x": 460,
    "y": 180,
    "wires": []
  },
  {
    "id": "bal-raw-status",
    "type": "ui-text",
    "z": "bal-tab",
    "group": "bal-group",
    "order": 1,
    "width": 12,
    "height": 1,
    "name": "Raw CAN health",
    "label": "Raw CAN",
    "format": "can1 receive-only frame: {{msg.payload}}",
    "layout": "row-spread",
    "style": false,
    "font": "Helvetica",
    "fontSize": 14,
    "color": "#717171",
    "wrapText": true,
    "className": "",
    "value": "payload",
    "valueType": "msg",
    "x": 750,
    "y": 160,
    "wires": []
  },
  {
    "id": "bal-status-inject",
    "type": "inject",
    "z": "bal-tab",
    "name": "TEST status",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "",
    "payload": "TEST; ACTIVE blocked; RS485 unavailable",
    "payloadType": "str",
    "x": 180,
    "y": 260,
    "wires": [["bal-status"]]
  },
  {
    "id": "bal-status",
    "type": "ui-text",
    "z": "bal-tab",
    "group": "bal-group",
    "order": 2,
    "width": 12,
    "height": 1,
    "name": "Controller status",
    "label": "Controller",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "style": false,
    "font": "Helvetica",
    "fontSize": 16,
    "color": "#717171",
    "wrapText": true,
    "className": "",
    "value": "payload",
    "valueType": "msg",
    "x": 450,
    "y": 260,
    "wires": []
  },
  {
    "id": "bal-help",
    "type": "ui-markdown",
    "z": "bal-tab",
    "group": "bal-group",
    "name": "Balancer documentation",
    "order": 3,
    "width": 12,
    "height": 8,
    "content": "__DASHBOARD_HELP__",
    "className": "",
    "x": 730,
    "y": 260,
    "wires": []
  }
]
