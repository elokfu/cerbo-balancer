#!/bin/sh
set -eu
exec 2>&1

PORT=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_A602K5MM-if00-port0
STOP_HOOK=/opt/victronenergy/serial-starter/stop-tty.sh
SERVICE=/data/home/nodered/cerbo-balancer/dyness_rs485_service.py
STATE_DIR=/data/home/nodered
LOCK_FILE=/var/run/cerbo-balancer-rs485.lock

# Keep overlapping or stale runit supervisors from starting a second serial
# client. The kernel releases this descriptor lock when the wrapper exits.
exec 9>"$LOCK_FILE"
flock 9

take_ownership() {
    if [ -x "$STOP_HOOK" ] && [ -e "$PORT" ]; then
        "$STOP_HOOK" ttyUSB0
    fi
}

take_ownership
setpriv --init-groups --reuid nodered --regid nodered \
    python3 "$SERVICE" --port "$PORT" --baud 115200 \
    --state-dir "$STATE_DIR" --quiet &
poller_pid=$!

cleanup() {
    kill "$poller_pid" 2>/dev/null || true
    wait "$poller_pid" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

while kill -0 "$poller_pid" 2>/dev/null; do
    if [ -e "$PORT" ]; then
        foreign_owner=0
        for owner in $(fuser "$PORT" 2>/dev/null || true); do
            if [ "$owner" != "$poller_pid" ]; then
                foreign_owner=1
            fi
        done
        # The serial-starter symlink is normally present even while its
        # workers are stopped.  It is not an ownership signal; invoking the
        # stop hook on every loop causes avoidable lock churn.  Reapply the
        # handoff only when a different process has actually opened the port.
        if [ "$foreign_owner" -eq 1 ]; then
            take_ownership
        fi
    fi
    sleep 2
done

wait "$poller_pid"
